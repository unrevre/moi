# settings
startup_message off

altscreen on
defbce on
defflow off
defscrollback 1024
escape ``
hardcopydir $HOME/.screen
windowlist string "%4n %h%=%f"

backtick 0 30 30 $HOME/.config/screen/stat-mem
backtick 1 30 30 $HOME/.config/screen/stat-cpu

# status bar
caption always
caption string '%{= 0;7}[%= %{0;7}%?%-w%?%{0;7}%?%F%{0;1}%?%?%P%{0;2}%?%?%E%{0;3}%? %n*%t %{0;7}%?%+w%?%{= 0;7} %=]'
hardstatus alwayslastline
hardstatus string '%{= 0;7}[%0`/%1`][%= %h (%S) %=]%{= 0;7}[%m/%d %C%A]'

# display settings
term screen-256color
termcapinfo xterm-256color 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'

# key bindings
bind K kill
bind Q quit

bind h focus left
bind j focus down
bind k focus up
bind l focus right
bind q only
bind t title
bind v split -v
bind w windowlist -b
bind x split

bind , prev
bind . next

# scrollback buffer (pgup, pgdown)
bindkey "^[[5~" eval "copy" "stuff ^b^e"
bindkey "^[[6~" eval "copy" "stuff ^f^y"

# start screen index at 1
screen 1
bind c screen 1
bind 0
